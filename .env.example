STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Signing secret for the Stripe webhook endpoint (api/webhook.js).
STRIPE_WEBHOOK_SECRET=whsec_...

# Where new-order emails go. api/webhook.js uses joseph@siphaven.com when this is empty.
ORDER_NOTIFY_EMAIL=you@example.com

# Resend API key. api/webhook.js uses it to send the new-order email.
RESEND_API_KEY=re_...

# Resend audience that email signups are added to.
RESEND_AUDIENCE_ID=your-resend-audience-id

# The shop's public address, with no path. After Stripe Checkout the shopper is sent
# back here. api/checkout.js only believes a request's Origin header when it is this
# address, the deployment's own address (VERCEL_URL) or, outside production,
# http://localhost:<port>; any other Origin gets this address. If this is unset and the
# Origin is not one of those, checkout answers 500 and logs that SITE_URL is missing.
SITE_URL=https://siphaven.com

# The store is open only when its flag is exactly "true"; unset or anything else
# keeps it closed. STORE_OPEN is read by the api/ functions and VITE_STORE_OPEN by
# the browser build, so set both the same.
STORE_OPEN=false
VITE_STORE_OPEN=false
