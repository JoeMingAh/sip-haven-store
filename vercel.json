{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "src/data/lineup.json"
    }
  },
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tea", "destination": "/tea.html" },
    { "source": "/coffee", "destination": "/coffee.html" },
    { "source": "/products/:slug", "destination": "/app.html" },
    { "source": "/quiz", "destination": "/quiz.html" },
    { "source": "/learn", "destination": "/app.html" },
    { "source": "/learn/:slug", "destination": "/app.html" },
    { "source": "/our-story", "destination": "/our-story.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/shipping-returns", "destination": "/shipping-returns.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/success", "destination": "/app.html" },
    { "source": "/cart", "destination": "/app.html" }
  ]
}
